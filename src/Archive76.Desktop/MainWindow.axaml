<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Archive76.Desktop.Models"
        x:Class="Archive76.Desktop.MainWindow"
        Title="Archive76"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1c2128" />
            <Setter Property="BorderBrush" Value="#30363d" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="#22262d" />
            <Setter Property="BorderBrush" Value="#484f58" />
        </Style>

        <Style Selector="ListBoxItem.sidebar-nav">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#7d8590" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem.sidebar-nav:pointerover">
            <Setter Property="Background" Value="#21262d" />
            <Setter Property="Foreground" Value="#e6edf3" />
        </Style>
        <Style Selector="ListBoxItem.sidebar-nav:selected">
            <Setter Property="Background" Value="#1f6feb" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.sidebar-btn">
            <Setter Property="Background" Value="#21262d" />
            <Setter Property="Foreground" Value="#7d8590" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.sidebar-btn:pointerover">
            <Setter Property="Background" Value="#30363d" />
            <Setter Property="Foreground" Value="#e6edf3" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260, *">
        <Border Grid.Column="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,24,20,16">
                    <StackPanel>
                        <TextBlock Text="Archive76" FontSize="20" FontWeight="Bold" Foreground="#e6edf3" />
                        <TextBlock Text="Fallout 76 Catalogue" FontSize="11" Foreground="#7d8590" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 — M1 Prototype" FontSize="10" Foreground="#484f58" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <Button DockPanel.Dock="Bottom" Classes="sidebar-btn" Content="Check for Updates" Margin="16,0,16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="8,8,8,0" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Classes="sidebar-nav" Content="Dashboard" />
                    <ListBoxItem Classes="sidebar-nav" Content="C.A.M.P. Plans" IsSelected="True" />
                    <ListBoxItem Classes="sidebar-nav" Content="Weapon Mods" />
                    <ListBoxItem Classes="sidebar-nav" Content="Armour Mods" />
                    <ListBoxItem Classes="sidebar-nav" Content="Favourites" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto">
            <StackPanel Grid.Row="0" Margin="24,20,24,12">
                <TextBlock x:Name="SectionTitle" Text="C.A.M.P. Plans" FontSize="24" FontWeight="SemiBold" Foreground="#e6edf3" />
                <TextBlock x:Name="SectionSubtitle" Text="Buildable items, plans and unlock conditions" FontSize="13" Foreground="#7d8590" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="24,0,24,16">
                <TextBox x:Name="SearchBox" PlaceholderText="Search plans..." Width="300" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="CategoryFilter" Width="180" />
                <ComboBox x:Name="SortFilter" Width="160" SelectionChanged="SortFilter_SelectionChanged">
                    <ComboBoxItem Content="Name (A-Z)" />
                    <ComboBoxItem Content="Category" />
                    <ComboBoxItem Content="Availability" />
                </ComboBox>
            </StackPanel>

            <Panel Grid.Row="2">
                <Border x:Name="LoadingPanel" IsVisible="True" Background="#0d1117">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Loading catalogue..." FontSize="16" Foreground="#7d8590" />
                        <TextBlock Text="Initialising local database" FontSize="12" Foreground="#484f58" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ContentArea" IsVisible="False" Padding="24,0,24,16">
                    <ItemsControl x:Name="CardGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MockCatalogueItem">
                                <Border Classes="card" Width="220" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Border Height="110" Background="#21262d">
                                            <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#484f58" FontSize="11" />
                                        </Border>
                                        <Border Padding="14,12,14,14">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#e6edf3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" Foreground="#7d8590" />
                                                <TextBlock Text="{Binding UnlockCondition}" FontSize="11" Foreground="#7d8590" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                                                    <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="6,3">
                                                        <TextBlock Text="{Binding Availability}" FontSize="10" Foreground="White" />
                                                    </Border>
                                                    <Border IsVisible="{Binding IsTrackable}" Background="#238636" CornerRadius="3" Padding="6,3">
                                                        <TextBlock Text="Trackable" FontSize="10" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="Form ID: " FontSize="10" Foreground="#484f58" />
                                                    <TextBlock Text="{Binding FormId}" FontSize="10" Foreground="#484f58" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="No items found" FontSize="18" Foreground="#7d8590" />
                    <TextBlock Text="Try adjusting your search or filters" FontSize="13" Foreground="#484f58" />
                </StackPanel>

                <StackPanel x:Name="ComingSoonPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Coming in M2" FontSize="18" Foreground="#7d8590" />
                    <TextBlock Text="This section is under development" FontSize="13" Foreground="#484f58" />
                </StackPanel>
            </Panel>

            <Border Grid.Row="3" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="24,8">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="ItemCountText" Text="0 items" FontSize="12" Foreground="#7d8590" />
                    <TextBlock Text="Local catalogue" FontSize="12" Foreground="#484f58" />
                    <TextBlock Text="Offline ready" FontSize="12" Foreground="#238636" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>